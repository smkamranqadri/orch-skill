#!/usr/bin/env python3
"""Read-only run board: board [RUN_DIR] --plain [--width 80]; Enter opens a card."""
import argparse
import curses
import datetime as dt
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import unicodedata

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent


def module(name, filename):
    spec = importlib.util.spec_from_file_location(name, ROOT / "scripts" / filename)
    result = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(result)
    return result


watch = module("orch_board_watch", "orch-watch.py")
usage = module("orch_board_usage", "orch-usage.py")


def read(path):
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def clean(value):
    value = str(value or "").strip().strip("`")
    value = "".join(c for c in value if not unicodedata.category(c).startswith("C"))
    if value.lower().rstrip(".") in ("", "-", "none"):
        return "none"
    return value


def cells(text):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
               for c in text)


def wrap(text, width):
    text = clean(text)
    lines = []
    while cells(text) > width:
        n, size = 0, 0
        for c in text:
            size += cells(c)
            if size > width:
                break
            n += 1
        cut = text.rfind(" ", 0, n + 1)
        if cut <= 0:
            cut = max(1, n)
        lines.append(text[:cut])
        text = text[cut:].lstrip()
    return lines + [text]


def when(t, now):
    local = t.astimezone(now.tzinfo)
    if local.date() == now.date():
        return local.strftime("%H:%M:%S")
    return local.strftime("%Y-%m-%d %H:%M:%S")


def ledger(text):
    rows, nexts, names, warnings = {}, [], {}, []
    repo, section, header = "none", "", None
    for line in text.splitlines():
        if line.startswith("# Orchestrator ledger:"):
            repo = clean(line.split(":", 1)[1])
        match = re.match(r"Next action(?: \(([^)]+)\))?:\s*(.*)$", line)
        if match:
            nexts.append((match[1] or "none", clean(match[2])))
        match = re.search(r"\bby ([\w.-]+).*?\b(w[^\s,;()]+:p[^\s,;()]+)", line)
        if line.startswith("Updated:") and match:
            names[match[2]] = match[1]
        if line.startswith("## "):
            section, header = line[3:].strip().lower(), None
        if section != "pane agents" or not line.lstrip().startswith("|"):
            continue
        values = watch.split_row(line)
        if all(re.fullmatch(r":?-{3,}:?", v) for v in values):
            continue
        if header is None:
            header = [v.lower() for v in values]
            continue
        if len(values) != len(header) or "name" not in header:
            warnings.append("ledger: malformed task row")
            continue
        row = dict(zip(header, values))
        name = row["name"].split(" (", 1)[0].strip()
        rows[name] = row
        pane = clean(row.get("pane"))
        if pane != "none":
            names[pane] = name
    return repo, rows, nexts, names, warnings


def owner_name(owner, names):
    owner = clean(owner)
    if owner in names:
        return f"{names[owner]} ({owner})"
    if re.fullmatch(r"w[^: ]+:p\S+", owner):
        return f"name unavailable ({owner})"
    return owner


def snapshot(directory, now=None, live_names=None):
    directory = Path(directory)
    now = now or dt.datetime.now().astimezone()
    text = read(directory / "ledger.md")
    repo, rows, nexts, names, warnings = ledger(text)
    names.update(live_names or {})
    if not text:
        warnings.append("ledger.md missing or unreadable")
    events, bad = watch.parse_log(str(directory))
    if bad:
        warnings.append(f"events.log: {len(bad)} unparsed line(s)")
    try:
        owners = watch.registrations(str(directory))
    except ValueError as exc:
        owners = {}
        warnings.append(str(exc))
    cache = Path(os.environ.get("ORCH_USAGE_CACHE_DIR") or
                 Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "orch")
    try:
        cached = json.loads(read(cache / "usage.json"))
        usage_text = usage.line(cached).removeprefix("usage ")
        stamp = cached.get("collected_at")
        if stamp:
            usage_text += " | cached " + when(dt.datetime.fromtimestamp(stamp, dt.timezone.utc), now)
    except (ValueError, TypeError, AttributeError, OverflowError, OSError):
        usage_text = "none"
    tasks, states, since = [], {}, {}
    all_names = dict.fromkeys([*rows, *owners, *(e["agent"] for e in events
                                            if e["kind"] not in ("watcher", "woken"))])
    for name in all_names:
        row = rows.get(name, {})
        own = watch.life(events, name)
        state_events = [e for e in own if e["kind"] == "state"]
        latest = state_events[-1] if state_events else None
        state = clean(row.get("status")).split(":", 1)[0].split(",", 1)[0]
        if latest and state not in ("closed", "merged", "gone", "queued"):
            state = latest["state"]
        states[name] = state
        if latest:
            since[name] = latest["t"]
        title = clean(row.get("title") or row.get("task"))
        if title == "none":
            title = next((clean(e["title"]) for e in reversed(state_events)
                          if clean(e["title"]) != "none"), name)
        ctx = next((clean(e["ctx"]) for e in reversed(state_events)
                    if clean(e["ctx"]) != "none"), "none")
        mark = watch.last_mark(events, name)
        evidence = "none"
        if mark:
            evidence = f"{mark['tier']} a{mark['attempt']}: {mark['what']} | proof {clean(mark['proof'])}"
        depends = clean(row.get("depends"))
        deps = [] if depends == "none" else re.split(r"[,\s]+", depends)
        started = "none"
        if latest:
            age = max(0, int((now - latest["t"]).total_seconds()))
            started = f"{age // 3600}h{age % 3600 // 60:02d}m | since {when(latest['t'], now)}"
        tasks.append(dict(name=name, title=title, state=state, model=clean(row.get("kind/model")),
                          pane=clean(row.get("pane")), owner=owner_name(owners.get(name) or row.get("owner"), names),
                          age=started, evidence=evidence, context=ctx, depends=deps, row=row))
    waiting = watch.ledger_waiting(str(directory))
    active = {t["name"] for t in tasks if t["state"] not in ("closed", "gone")}
    needs = watch.needs_you(events, set(owners) | active, states, since, now, waiting=waiting, usage=usage_text)
    need_lines = []
    for stamp, message in needs:
        need_lines.append((when(stamp, now) + " " if stamp else "") + message)
    return dict(repo=repo, now=now, tasks=tasks, events=events, usage=usage_text,
                nexts=[(owner_name(owner, names), action) for owner, action in nexts],
                needs=need_lines, warnings=warnings)


def layers(tasks):
    pending = list(tasks)
    done = set()
    while pending:
        ready = [t for t in pending if set(t["depends"]) <= done]
        if not ready:
            yield pending
            return
        yield ready
        done.update(t["name"] for t in ready)
        pending = [t for t in pending if t not in ready]


def task_lines(task):
    return [task["title"], "CLI/model: " + task["model"], "Owner: " + task["owner"],
            "Pane: " + task["pane"], "Age: " + task["age"], "Evidence: " + task["evidence"],
            "Context: " + task["context"], "Depends: " + (", ".join(task["depends"]) or "none")]


def recent(events, now):
    lines, day = [], None
    for event in events[-8:]:
        event_day = event["t"].astimezone(now.tzinfo).date()
        if event_day != day:
            day = event_day
            lines.append("[" + ("Today " if day == now.date() else "") + str(day) + "]")
        detail = event["kind"]
        if detail == "state":
            detail = event["state"] + ": " + clean(event["title"])
        elif detail == "mark":
            detail = f"{event['tier']}: {event['what']} | proof {clean(event['proof'])}"
        elif detail == "woken":
            detail = "woken: " + ", ".join(event["agents"])
        lines.append(f"{when(event['t'], now)} {event['agent']} {detail}")
    return lines or ["none"]


def render(data, width=80, selected=None, card=None):
    width = max(20, width)
    lines, positions = [], {}

    def add(text, style=""):
        lines.extend((part, [(0, cells(part), style)]) for part in wrap(text, width))

    add(f"Orch | {data['repo']} | {data['now'].strftime('%Y-%m-%d %H:%M:%S %Z')}")
    add("Usage: " + data["usage"])
    for owner, action in data["nexts"] or [("none", "none")]:
        add(f"Next action ({owner}): {action}")
    add("Needs-you: " + ("; ".join(data["needs"]) or "none"), "blocked" if data["needs"] else "")
    for warning in data["warnings"]:
        add("Notice: " + warning, "blocked")
    add("Card" if card else "Tasks")
    tasks = data["tasks"]
    if card:
        task = next((t for t in tasks if t["name"] == card), None)
        if task:
            add(f"{task['name']} [{task['state']}]", task["state"])
            for line in task_lines(task):
                add(line)
            for key in ("worktree / branch", "owns", "brief", "handoff", "status", "last event"):
                add(f"{key}: {clean(task['row'].get(key))}")
            add("Recent")
            for line in recent([e for e in data["events"] if e["agent"] == card or
                                (e["kind"] == "woken" and card in e["agents"])], data["now"]):
                add(line)
        else:
            add("none")
    else:
        if not tasks:
            add("none")
        for level in layers(tasks):
            edges = [f"{dep} -> {t['name']}" for t in level for dep in t["depends"]]
            if edges:
                add("; ".join(edges))
            columns = max(1, width // 39)
            for start in range(0, len(level), columns):
                group = level[start:start + columns]
                box_width = (width - (len(group) - 1) * 2) // len(group)
                boxes = []
                for task in group:
                    positions[task["name"]] = len(lines)
                    heading = f"{task['name']} [{task['state']}]"
                    if selected == task["name"]:
                        heading = "> " + heading
                    content = [heading, *task_lines(task)]
                    body = [part for text in content for part in wrap(text, box_width - 4)]
                    boxes.append(body)
                height = max(map(len, boxes))
                for y in range(height + 2):
                    parts, spans, x = [], [], 0
                    for task, body in zip(group, boxes):
                        part = "+" + "-" * (box_width - 2) + "+"
                        if 0 < y < height + 1:
                            text = body[y - 1] if y <= len(body) else ""
                            part = "| " + text + " " * (box_width - cells(text) - 3) + "|"
                        parts.append(part)
                        style = task["state"]
                        if selected == task["name"]:
                            style += ":selected"
                        spans.append((x, box_width, style))
                        x += box_width + 2
                    lines.append(("  ".join(parts), spans))
        add("Recent")
        for line in recent(data["events"], data["now"]):
            add(line)
    add("Keys: Tab/j/k/arrows select | Enter card | Esc back | PgUp/PgDn scroll | q quit")
    return lines, positions


COLORS = {"working": curses.COLOR_CYAN, "blocked": curses.COLOR_YELLOW,
          "done": curses.COLOR_GREEN, "merged": curses.COLOR_GREEN, "closed": curses.COLOR_MAGENTA,
          "gone": curses.COLOR_MAGENTA, "queued": curses.COLOR_YELLOW,
          "idle": curses.COLOR_CYAN, "unknown": curses.COLOR_YELLOW}


def live_owner_names():
    if os.environ.get("HERDR_ENV") != "1":
        return {}
    try:
        payload = json.loads(herdr("agent", "list").stdout)
        return {entry["pane_id"]: entry["name"] for entry in payload["result"]["agents"]
                if entry.get("name") and entry.get("pane_id")}
    except (ValueError, KeyError, TypeError, AttributeError, OSError, subprocess.SubprocessError):
        return {}


def ui(screen, directory):
    curses.curs_set(0)
    screen.keypad(True)
    screen.timeout(1000)
    pairs = {}
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        for i, (state, color) in enumerate(COLORS.items(), 1):
            curses.init_pair(i, color, -1)
            pairs[state] = curses.color_pair(i)
    selected, card, offset = None, None, 0
    owner_names, owner_refresh = {}, 0
    while True:
        if time.monotonic() >= owner_refresh:
            owner_names = live_owner_names()
            owner_refresh = time.monotonic() + 60
        data = snapshot(directory, live_names=owner_names)
        names = [t["name"] for t in data["tasks"]]
        if selected not in names:
            selected = next(iter(names), None)
        height, width = screen.getmaxyx()
        lines, positions = render(data, max(20, width - 1), selected, card)
        body, footer = lines[:-1], lines[-1]
        offset = min(offset, max(0, len(body) - height + 1))
        visible = body[offset:offset + max(0, height - 1)]
        visible += [("", [])] * max(0, height - 1 - len(visible))
        visible.append(footer)
        screen.erase()
        for y, (text, spans) in enumerate(visible):
            for x, length, style in spans:
                state = style.split(":")[0]
                attr = pairs.get(state, 0)
                if style.endswith(":selected"):
                    attr |= curses.A_BOLD
                piece = ""
                column = 0
                for char in text:
                    if x <= column < x + length:
                        piece += char
                    column += cells(char)
                try:
                    screen.addstr(y, x, piece, attr)
                except curses.error:
                    pass
        screen.refresh()
        key = screen.getch()
        if key == ord("q"):
            return
        if key in (27, curses.KEY_BACKSPACE):
            card, offset = None, 0
        elif key in (10, 13, curses.KEY_ENTER) and selected:
            card, offset = selected, 0
        elif key in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            step = max(1, height - 2)
            offset = max(0, offset + (step if key == curses.KEY_NPAGE else -step))
        elif key in (9, ord("j"), ord("k"), curses.KEY_DOWN, curses.KEY_UP,
                     curses.KEY_LEFT, curses.KEY_RIGHT) and names:
            step = -1 if key in (ord("k"), curses.KEY_UP, curses.KEY_LEFT) else 1
            selected = names[(names.index(selected) + step) % len(names)]
            if card:
                card, offset = selected, 0
            else:
                offset = max(0, positions.get(selected, 0) - 5)


def herdr(*args):
    return subprocess.run([os.environ.get("HERDR_BIN_PATH") or "herdr", *args],
                          check=True, capture_output=True, text=True, timeout=15)


def run_dir(argument=None, opening=False):
    path = argument or os.environ.get("ORCH_RUN_DIR")
    if path:
        return Path(path).expanduser().resolve()
    cwd = Path.cwd()
    if opening:
        context = json.loads(os.environ.get("HERDR_PLUGIN_CONTEXT_JSON", "{}"))
        source = context.get("cwd") or context.get("worktree_path")
        if not source:
            pane = context.get("pane_id") or os.environ.get("HERDR_PANE_ID")
            if not pane:
                raise ValueError("board action needs a pane context or ORCH_RUN_DIR")
            result = json.loads(herdr("pane", "current", "--pane", pane).stdout)
            source = result["result"]["pane"]["cwd"]
        cwd = Path(source)
    result = subprocess.run(["bash", str(ROOT / "scripts" / "orch-dir.sh"), "--check", str(cwd)],
                            check=True, capture_output=True, text=True, timeout=15)
    return Path(result.stdout.strip()).resolve()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory", nargs="?")
    parser.add_argument("--plain", action="store_true")
    parser.add_argument("--width", type=int, default=80)
    parser.add_argument("--card", metavar="AGENT")
    parser.add_argument("--open", action="store_true", help="Herdr action: open the board split")
    args = parser.parse_args()
    if args.open and os.environ.get("HERDR_ENV") != "1":
        raise ValueError("board action must run inside Herdr")
    directory = run_dir(args.directory, args.open)
    if args.open:
        herdr("plugin", "pane", "open", "--plugin", "orch", "--entrypoint", "board",
              "--cwd", str(directory.parent), "--env", f"ORCH_RUN_DIR={directory}")
    elif args.plain:
        print("\n".join(text for text, _ in render(snapshot(directory, live_names=live_owner_names()), args.width, card=args.card)[0]))
    else:
        curses.wrapper(ui, directory)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, subprocess.SubprocessError, curses.error) as exc:
        print(f"orch board: {exc}", file=sys.stderr)
        sys.exit(1)
